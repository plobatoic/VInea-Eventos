---
import { getCollection } from 'astro:content';
import { sitio, menu } from '../data/sitio';
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const anio = new Date().getFullYear();
---

<footer class="pie seccion--oscura">
  <div class="contenedor">
    <div class="pie__cta">
      <p class="etiqueta">¿Empezamos?</p>
      <h2 class="pie__titulo" data-split>Cuéntanos tu <em>próximo evento</em></h2>
      <div class="pie__acciones" data-reveal>
        <a class="pie__email" href={`mailto:${sitio.email}`}>{sitio.email}</a>
        <a class="boton boton--naranja" href="/contacto/">Pide tu propuesta <span class="flecha" aria-hidden="true">→</span></a>
      </div>
      <div class="gota-deco pie__gota" aria-hidden="true"></div>
    </div>

    <div class="pie__columnas">
      <div>
        <img class="pie__logo" src="/img/logo-vinea-claro.svg" alt="Vinea Eventos y Turismo" width="1353" height="435" loading="lazy" />
        <p class="pie__claim">Producción integral de eventos para empresas e instituciones, con las personas en el centro.</p>
        <ul class="pie__tel">
          {sitio.telefonos.map((t) => <li><a href={t.href}>{t.texto}</a></li>)}
        </ul>
      </div>
      <nav aria-label="Servicios">
        <h3 class="pie__h">Servicios</h3>
        <ul>
          {servicios.map((s) => <li><a href={`/servicios/${s.id}/`}>{s.data.titulo}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Vinea">
        <h3 class="pie__h">Vinea</h3>
        <ul>
          {menu.filter((m) => m.href !== '/servicios/').map((m) => <li><a href={m.href}>{m.texto}</a></li>)}
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
        <h3 class="pie__h pie__h--sep">Síguenos</h3>
        <ul>
          {sitio.redes.map((r) => <li><a href={r.href} rel="noopener" target="_blank">{r.nombre}<span class="sr-only"> (se abre en otra pestaña)</span></a></li>)}
        </ul>
      </nav>
    </div>

    <div class="pie__base">
      <p>© {anio} {sitio.nombre}</p>
      <ul>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/politica-privacidad/">Privacidad</a></li>
        <li><a href="/politica-cookies/">Cookies</a></li>
        <li><a href="/accesibilidad-web/">Accesibilidad web</a></li>
      </ul>
      <button class="pie__movimiento" type="button" data-movimiento aria-pressed="false">
        <span class="pie__interruptor" aria-hidden="true"></span>
        <span>Reducir animaciones</span>
      </button>
    </div>
  </div>
</footer>

<style>
  .pie { padding: var(--seccion) 0 40px; position: relative; overflow: hidden; }
  .pie__cta { position: relative; padding-bottom: clamp(64px, 9vw, 120px); border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .pie__titulo { font-size: var(--t-mega); line-height: 0.95; letter-spacing: -0.035em; max-width: 11ch; position: relative; z-index: 1; }
  .pie__titulo :global(em) { color: var(--coral); font-style: italic; }
  .pie__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 36px; margin-top: 44px; position: relative; z-index: 1; }
  .pie__email { font-family: var(--ff-display); font-size: clamp(1.4rem, 2.6vw, 2.2rem); text-decoration: none; border-bottom: 1px solid rgba(255, 255, 255, 0.35); }
  .pie__email:hover { color: var(--coral); border-color: var(--coral); }
  .pie__gota { width: clamp(180px, 30vw, 420px); right: -2vw; top: 0; opacity: 0.95; animation: flotar 9s ease-in-out infinite; }
  @keyframes flotar { 50% { transform: translateY(-18px) rotate(4deg); } }
  .pie__columnas { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 48px; padding-block: 64px; }
  .pie__logo { width: 150px; margin-bottom: 22px; }
  .pie__claim { color: #b9b0a4; max-width: 34ch; }
  .pie ul { list-style: none; margin: 0; padding: 0; }
  .pie__columnas li { margin: 0.35em 0; }
  .pie__columnas a { text-decoration: none; color: #e9e2d8; }
  .pie__columnas a:hover { color: var(--coral); }
  .pie__tel { margin-top: 18px !important; font-size: 1.1rem; }
  .pie__h { font-family: var(--ff-texto); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #8f877c; margin-bottom: 14px; }
  .pie__h--sep { margin-top: 32px; }
  .pie__base { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; padding-top: 28px; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.9rem; color: #a59d91; }
  .pie__base p { margin: 0; }
  .pie__base ul { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .pie__base a { color: #a59d91; text-decoration: none; }
  .pie__base a:hover { color: #fff; }
  .pie__movimiento { margin-left: auto; display: inline-flex; align-items: center; gap: 10px; background: none; border: 0; color: #d5cdc2; font-size: 0.9rem; padding: 6px 0; }
  .pie__interruptor { width: 38px; height: 22px; border-radius: 999px; background: #3a352f; position: relative; transition: background 0.3s; }
  .pie__interruptor::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.3s var(--ease-out); }
  .pie__movimiento[aria-pressed='true'] .pie__interruptor { background: var(--naranja); }
  .pie__movimiento[aria-pressed='true'] .pie__interruptor::after { transform: translateX(16px); }
  @media (max-width: 820px) {
    .pie__columnas { grid-template-columns: 1fr 1fr; }
    .pie__columnas > div:first-child { grid-column: 1 / -1; }
    .pie__movimiento { margin-left: 0; }
    .pie__gota { opacity: 0.35; }
  }
</style>
