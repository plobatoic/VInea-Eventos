---
import { getCollection } from 'astro:content';
import { menu } from '../data/sitio';
const todos = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const servicios = todos.filter((s) => s.data.tipo === 'servicio');
const experiencias = todos.filter((s) => s.data.tipo === 'experiencia');
const ruta = Astro.url.pathname;
const activo = (href: string) => ruta === href || (href !== '/' && ruta.startsWith(href));
---

<header class="cabecera" data-cabecera>
  <div class="cabecera__in">
    <a href="/" class="cabecera__logo" aria-label="Vinea Eventos y Turismo, ir al inicio">
      <img src="/img/logo-vinea.svg" alt="" width="1353" height="435" />
    </a>

    <nav class="cabecera__nav" id="menu-principal" aria-label="Principal" data-menu data-lenis-prevent>
      <ul>
        {
          menu.map((m, i) =>
            m.submenu ? (
              <li style={`--i:${i}`} class="con-sub" data-sub>
                <a href={m.href} aria-current={activo(m.href) ? 'page' : undefined}>
                  {m.texto}
                </a>
                <button type="button" class="sub-boton" aria-expanded="false" aria-controls="submenu-servicios" data-sub-boton>
                  <span class="sr-only">Ver todos los servicios</span>
                  <span aria-hidden="true" class="sub-flecha" />
                </button>
                <div class="submenu" id="submenu-servicios">
                  <div class="submenu__col">
                    <p class="submenu__h">Servicios</p>
                    <ul>
                      {servicios.map((s) => (
                        <li><a href={`/servicios/${s.id}/`} aria-current={ruta.startsWith(`/servicios/${s.id}/`) ? 'page' : undefined}>{s.data.titulo}</a></li>
                      ))}
                    </ul>
                  </div>
                  <div class="submenu__col submenu__col--exp">
                    <p class="submenu__h">Experiencias</p>
                    <ul>
                      {experiencias.map((s) => (
                        <li><a href={`/servicios/${s.id}/`}>{s.data.titulo}</a></li>
                      ))}
                    </ul>
                    <a class="submenu__todos" href="/servicios/">Ver todos los servicios →</a>
                  </div>
                </div>
              </li>
            ) : (
              <li style={`--i:${i}`}>
                <a href={m.href} aria-current={activo(m.href) ? 'page' : undefined}>
                  {m.texto}
                </a>
              </li>
            ),
          )
        }
        <li class="cabecera__solo-movil" style={`--i:${menu.length}`}>
          <a href="/contacto/" aria-current={activo('/contacto/') ? 'page' : undefined}>Contacto</a>
        </li>
      </ul>
      <p class="cabecera__solo-movil cabecera__dato">
        <a href="mailto:info@vineaeventos.com">info@vineaeventos.com</a>
      </p>
    </nav>

    <a class="boton boton--naranja cabecera__cta" href="/contacto/">Pide tu propuesta <span class="flecha" aria-hidden="true">→</span></a>

    <button class="cabecera__boton" type="button" aria-expanded="false" aria-controls="menu-principal" data-menu-boton>
      <span class="sr-only" data-menu-texto>Abrir menú</span>
      <span class="hamb" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .cabecera {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    padding: 14px var(--gutter);
    transition: transform 0.5s var(--ease-out);
    view-transition-name: cabecera;
  }
  .cabecera__in {
    display: flex; align-items: center; gap: 24px;
    max-width: calc(var(--max) + 40px); margin-inline: auto;
    padding: 10px 10px 10px 22px; border-radius: 999px;
    transition: background 0.4s, box-shadow 0.4s, backdrop-filter 0.4s;
  }
  :global(.cabecera.solida) .cabecera__in {
    background: rgba(255, 253, 249, 0.82);
    backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 var(--linea), 0 12px 40px -18px rgba(20, 18, 16, 0.25);
  }
  :global(.cabecera.oculta) { transform: translateY(-120%); }
  .cabecera__logo { flex: none; display: block; width: clamp(104px, 10vw, 132px); }
  .cabecera__nav { margin-left: auto; }
  .cabecera__nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(14px, 2vw, 30px); }
  .cabecera__nav a {
    position: relative; text-decoration: none; font-weight: 500; font-size: 0.98rem; padding: 6px 0;
  }
  .cabecera__nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; border-radius: 2px;
    background: var(--naranja); transform: scaleX(0); transform-origin: right; transition: transform 0.45s var(--ease-out);
  }
  .cabecera__nav a:hover::after, .cabecera__nav a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .cabecera__cta { padding: 0.85em 1.3em; font-size: 0.95rem; }
  .con-sub { position: relative; display: flex; align-items: center; gap: 2px; }
  .sub-boton { border: 0; background: none; width: 28px; height: 28px; padding: 0; display: grid; place-items: center; border-radius: 50%; }
  .sub-flecha { width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 0.4s var(--ease-out); }
  .submenu {
    position: absolute; top: calc(100% + 18px); left: 50%; translate: -50% 0;
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; width: min(640px, 80vw);
    padding: 28px 30px; border-radius: 24px; background: var(--papel);
    box-shadow: 0 1px 0 var(--linea), 0 30px 70px -20px rgba(20, 18, 16, 0.3);
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: opacity 0.3s, transform 0.4s var(--ease-out), visibility 0s 0.3s;
  }
  .submenu::before { content: ''; position: absolute; left: 0; right: 0; top: -20px; height: 20px; }
  .con-sub:hover .submenu, .con-sub:focus-within .submenu, .con-sub.abierto .submenu { opacity: 1; visibility: visible; transform: none; transition: opacity 0.3s, transform 0.4s var(--ease-out), visibility 0s; }
  .con-sub:hover .sub-flecha, .con-sub.abierto .sub-flecha { transform: translateY(1px) rotate(-135deg); }
  .submenu ul { list-style: none; margin: 0; padding: 0; display: block !important; }
  .submenu li { margin: 0; }
  .submenu a { display: block; padding: 7px 0; font-weight: 400; font-size: 0.98rem; }
  .submenu a::after { display: none; }
  .submenu a:hover, .submenu a[aria-current='page'] { color: var(--naranja-texto); }
  .submenu__h { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gris); margin: 0 0 8px; }
  .submenu__col--exp { padding-left: 28px; border-left: 1px solid var(--linea); }
  .submenu .submenu__todos { margin-top: 18px; font-weight: 600; color: var(--naranja-texto); }
  .cabecera__boton, .cabecera__solo-movil { display: none; }

  @media (max-width: 1020px) {
    .cabecera__in { padding: 8px 8px 8px 18px; }
    .cabecera__cta { display: none; }
    .cabecera__boton {
      display: grid; place-items: center; margin-left: auto; width: 52px; height: 52px; border-radius: 50%;
      border: 0; background: var(--tinta); position: relative; z-index: 2;
    }
    .hamb { width: 20px; height: 10px; position: relative; }
    .hamb span { position: absolute; left: 0; right: 0; height: 2px; background: #fff; border-radius: 2px; transition: transform 0.45s var(--ease-out), top 0.45s var(--ease-out); }
    .hamb span:first-child { top: 0; }
    .hamb span:last-child { top: 8px; }
    [aria-expanded='true'] .hamb span:first-child { top: 4px; transform: rotate(45deg); }
    [aria-expanded='true'] .hamb span:last-child { top: 4px; transform: rotate(-45deg); }
    .cabecera__nav {
      position: fixed; inset: 0; z-index: 1; margin: 0;
      background: var(--noche); color: #f4efe8;
      display: flex; flex-direction: column; justify-content: flex-start; padding: 110px var(--gutter) 40px; overflow-y: auto; overscroll-behavior: contain;
      clip-path: circle(0% at calc(100% - 46px) 46px); visibility: hidden;
      transition: clip-path 0.7s var(--ease-out), visibility 0s 0.7s;
    }
    :global(.menu-abierto) .cabecera__nav { clip-path: circle(150% at calc(100% - 46px) 46px); visibility: visible; transition: clip-path 0.8s var(--ease-out), visibility 0s; }
    :global(.menu-abierto) .cabecera__logo { filter: invert(1) hue-rotate(180deg) brightness(1.6); position: relative; z-index: 2; }
    .cabecera__nav ul { flex-direction: column; gap: 6px; }
    .cabecera__nav > ul { margin-top: auto; }
    .cabecera__nav > .cabecera__dato { margin-bottom: auto; }
    .cabecera__nav li { opacity: 0; transform: translateY(24px); transition: opacity 0.5s, transform 0.6s var(--ease-out); transition-delay: calc(var(--i) * 50ms + 150ms); }
    :global(.menu-abierto) .cabecera__nav li { opacity: 1; transform: none; }
    .cabecera__nav a { font-family: var(--ff-display); font-size: clamp(2.1rem, 9vw, 3.4rem); font-weight: 400; letter-spacing: -0.02em; }
    .cabecera__nav a::after { height: 3px; }
    .cabecera__solo-movil { display: block; }
    .con-sub { flex-wrap: wrap; }
    .sub-boton { width: 44px; height: 44px; margin-left: 8px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35); color: #fff; }
    .submenu { position: static; translate: none; width: 100%; grid-template-columns: 1fr; gap: 10px; padding: 0 0 0 4px; background: none; box-shadow: none; border-radius: 0; display: none; opacity: 1; visibility: visible; transform: none; }
    .con-sub:hover .submenu, .con-sub:focus-within .submenu { display: none; }
    .con-sub.abierto .submenu { display: grid; padding: 8px 0 14px 4px; }
    .submenu a { font-family: var(--ff-texto) !important; font-size: 1.05rem !important; color: #d9d1c6; padding: 6px 0; }
    .submenu__h { color: #8f877c; margin-top: 6px; }
    .submenu__col--exp { padding-left: 0; border: 0; }
    .cabecera__dato { margin-top: 32px; }
    .cabecera__dato a { font-family: var(--ff-texto); font-size: 1.05rem; color: var(--coral); }
  }
</style>
