---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import LogoAnimado from '../components/LogoAnimado.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { getCollection } from 'astro:content';
import { fecha } from '../data/sitio';
import home from '../content/home.json';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const proyectos = (await getCollection('proyectos'))
  .filter((p) => p.data.destacado)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 5);
const hoy = new Date('2026-11-17');
const eventos = (await getCollection('eventos'))
  .filter((e) => e.data.estado !== 'pasado' && e.data.fecha >= hoy)
  .sort((a, b) => a.data.fecha.getTime() - b.data.fecha.getTime())
  .slice(0, 3);

// El titular resalta "emocionales" en cursiva naranja
const claim = home.claim.replace(/(emocionales)/i, '<em>$1</em>');

const fotoPortal = 'Gran-Teatre-Liceu-Premios-Ondas-2024.jpg';
// Fotos que pasan dentro de la gota mientras se abre (la última se queda)
const montaje = [
  { src: 'DJI_0063-2-scaled.jpg', alt: 'Vista aérea de una masía entre viñedos con Montserrat al fondo' },
  { src: 'Port-Barcelona-Musica-scaled.jpg', alt: 'Concierto en directo ante el público en el Port de Barcelona' },
  { src: fotoPortal, alt: 'Patio de butacas lleno en el Gran Teatre del Liceu durante los Premios Ondas 2024' },
];
const opiniones: { texto: string; autor?: string }[] = [home.testimonio, ...((home as any).testimonios ?? [])];
const momentos = [
  { src: 'DJI_0063-2-scaled.jpg', alt: 'Vista aérea de una masía entre viñedos con Montserrat al fondo' },
  { src: 'Port-Barcelona-Musica-scaled.jpg', alt: 'Grupo de rumba catalana tocando en directo ante el público en el Port de Barcelona' },
  { src: 'Ruta-en-bici-fira-Pals-Vineaeventos-scaled.jpg', alt: 'Ruta en bicicleta entre campos de flores amarillas con el pueblo de Pals al fondo' },
  { src: 'Oller-del-Mas_128-scaled.jpg', alt: 'Persona catando una copa de vino blanco' },
  { src: '30-aniversario-Montana-Colors-scaled.jpg', alt: 'Invitados escuchando un discurso en una celebración de empresa' },
];
---

<Base
  titulo="Vinea Eventos y Turismo · Agencia de eventos en Barcelona"
  descripcion="Agencia de eventos en Barcelona para empresas e instituciones. Congresos, ferias, galas, team building y experiencias accesibles con producción integral."
  imagen={fotoPortal}
>
  <!-- ============ HERO: el logo completo de Vinea ============ -->
  <section class="hero" data-hero aria-labelledby="hero-titulo">
    <div class="hero__brillo" aria-hidden="true" data-hero-brillo></div>
    <canvas class="hero__gota" aria-hidden="true" data-gota></canvas>
    <div class="hero__gota-plana" aria-hidden="true" data-gota-plana></div>

    <div class="hero__centro contenedor" data-hero-centro>
      <div class="hero__logo" data-hero-logo>
        <LogoAnimado titulo="Vinea Eventos y Turismo" />
      </div>
      <p class="etiqueta hero__etiqueta" data-hero-fade>Agencia de eventos y turismo · Barcelona</p>
      <h1 id="hero-titulo" class="hero__claim" data-hero-fade="sin-entrada" set:html={claim} />
      <div class="hero__acciones" data-hero-fade>
        <a class="boton" href="/contacto/">Pide tu propuesta <span class="flecha" aria-hidden="true">→</span></a>
        <a class="enlace-flecha" href="#servicios">Descubre qué hacemos</a>
      </div>
    </div>

    <div class="hero__bajar" aria-hidden="true" data-hero-bajar><span></span>Desliza</div>

    <div class="hero__portal" data-portal>
      {
        montaje.map((m, i) => (
          <div class="hero__portal-foto" data-portal-foto style={`z-index:${i}`}>
            <Foto src={m.src} alt={m.alt} sizes="100vw" anchos={[800, 1200, 1700, 2048]} />
          </div>
        ))
      }
      <div class="hero__portal-texto contenedor sobre-oscuro" data-portal-texto>
        <p class="etiqueta">Premios Ondas 2024 · Gran Teatre del Liceu</p>
        <p class="titulo-1">Producción integral,<br /><em>de la idea al último aplauso.</em></p>
      </div>
    </div>
  </section>

  <!-- ============ FRANJA DE SERVICIOS (se desliza con el scroll) ============ -->
  <section class="franja" aria-label="Lo que hacemos">
    <p class="franja__fila" data-franja="-1">
      {[0, 1].map(() => servicios.filter((s) => s.data.tipo === 'servicio').map((s) => (<span>{s.data.titulo}<i class="franja__gota" aria-hidden="true" /></span>)))}
    </p>
    <p class="franja__fila franja__fila--b" data-franja="1" aria-hidden="true">
      {[0, 1].map(() => ['Producción integral', 'Accesibilidad', 'Turismo MICE', 'Experiencias', 'Sostenibilidad', 'Barcelona'].map((t) => (<span>{t}<i class="franja__gota" aria-hidden="true" /></span>)))}
    </p>
  </section>

  <!-- ============ QUIÉNES SOMOS ============ -->
  <section class="seccion intro" aria-labelledby="intro-titulo">
    <div class="contenedor intro__grid">
      <div>
        <p class="etiqueta" data-reveal>Somos Vinea</p>
        <h2 id="intro-titulo" class="titulo-2" data-split>Eventos con <em>personas</em> en el centro</h2>
      </div>
      <div>
        <p class="entradilla" data-reveal>{home.intro}</p>
        <a class="enlace-flecha" href="/nuestra-esencia/" data-reveal>Conoce nuestra esencia →</a>
      </div>
    </div>
    <ol class="contenedor pilares">
      {
        home.pilares.map((p: { titulo: string; texto: string }, i: number) => (
          <li class="pilar" data-reveal style={`--d:${i * 120}`}>
            <span class="pilar__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="titulo-3">{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============ SERVICIOS (scroll horizontal en escritorio) ============ -->
  <section class="servicios seccion--papel" id="servicios" data-servicios aria-labelledby="servicios-titulo">
    <div class="servicios__cabeza contenedor">
      <p class="etiqueta" data-reveal>Qué hacemos</p>
      <h2 id="servicios-titulo" class="titulo-1" data-split>Servicios a <em>medida</em></h2>
      <p class="entradilla" data-reveal>De un congreso con cientos de asistentes a una experiencia íntima para tu equipo. Lo diseñamos, lo producimos y lo cuidamos de principio a fin.</p>
    </div>
    <div class="servicios__ventana">
      <ul class="servicios__pista" data-pista>
        {
          servicios.map((s, i) => (
            <li class="servicios__item" data-servicio>
              <TarjetaServicio
                slug={s.id}
                titulo={s.data.titulo}
                resumen={s.data.resumen}
                imagen={s.data.imagen}
                imagenAlt={s.data.imagenAlt}
                etiqueta={s.data.etiqueta}
                numero={i + 1}
                tipo={s.data.tipo}
              />
            </li>
          ))
        }
        <li class="servicios__item servicios__item--final">
          <a class="servicios__todos" href="/servicios/">
            <span class="titulo-2">Ver todos los servicios</span>
            <span class="servicios__todos-flecha" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ CIFRAS ============ -->
  <section class="seccion seccion--oscura cifras" aria-labelledby="cifras-titulo">
    <div class="gota-deco cifras__gota" aria-hidden="true" data-parallax="-0.25"></div>
    <div class="contenedor">
      <p class="etiqueta" data-reveal>En números</p>
      <h2 id="cifras-titulo" class="titulo-2 cifras__titulo" data-split>Lo que ya hemos <em>hecho realidad</em></h2>
      <dl class="cifras__lista">
        {
          home.cifras.map((c: { valor: string; etiqueta: string }, i: number) => (
            <div class="cifra" data-reveal style={`--d:${i * 100}`}>
              <dt class="cifra__valor" data-count={c.valor}>{c.valor}</dt>
              <dd class="cifra__texto">{c.etiqueta}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ PROYECTOS ============ -->
  <section class="seccion proyectos" aria-labelledby="proyectos-titulo">
    <div class="contenedor">
      <div class="proyectos__cabeza">
        <div>
          <p class="etiqueta" data-reveal>Proyectos</p>
          <h2 id="proyectos-titulo" class="titulo-1" data-split>Historias que <em>hemos producido</em></h2>
        </div>
        <a class="boton boton--linea" href="/proyectos/" data-reveal>Ver todos los proyectos <span class="flecha" aria-hidden="true">→</span></a>
      </div>
      <div class="proyectos__grid">
        {
          proyectos.map((p, i) => (
            <div class={`proyectos__celda proyectos__celda--${i}`} data-reveal style={`--d:${(i % 2) * 120}`}>
              <TarjetaProyecto
                slug={p.id}
                titulo={p.data.titulo}
                resumen={p.data.resumen}
                imagen={p.data.imagen}
                imagenAlt={p.data.imagenAlt}
                lugar={p.data.lugar}
                cliente={p.data.cliente}
                date={p.data.fecha}
                cifra={p.data.cifras[0]}
                grande={i === 0}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ACCESIBILIDAD ============ -->
  <section class="accesible" aria-labelledby="accesible-titulo">
    <div class="contenedor accesible__grid">
      <div class="accesible__texto">
        <p class="etiqueta accesible__etiqueta" data-reveal>Accesibilidad e inclusión</p>
        <h2 id="accesible-titulo" class="titulo-1" data-split>Eventos para <em>todas</em> las personas</h2>
        <p class="accesible__p" data-reveal>Catas para personas sordas con intérprete de lengua de signos, recorridos en silla de ruedas por el centro de Manresa, el evento de CrossFit inclusivo más grande del mundo… La accesibilidad no es un añadido: es nuestra forma de trabajar.</p>
        <a class="boton" href="/accesibilidad-e-inclusion/" data-reveal>Nuestro compromiso <span class="flecha" aria-hidden="true">→</span></a>
      </div>
      <div class="accesible__foto con-gota" data-reveal="foto">
        <Foto src="Business-Events-Port-Aventura.jpg" alt="Gran grupo de personas reunidas en una acción de responsabilidad social corporativa" sizes="(max-width: 900px) 90vw, 45vw" anchos={[600, 900, 1300]} />
      </div>
    </div>
  </section>

  <!-- ============ MOMENTOS (collage con profundidad) ============ -->
  <section class="seccion momentos" aria-labelledby="momentos-titulo">
    <div class="contenedor momentos__cabeza">
      <p class="etiqueta" data-reveal>Momentos Vinea</p>
      <h2 id="momentos-titulo" class="titulo-mega" data-split>Cada evento, <em>una historia</em></h2>
    </div>
    <div class="momentos__collage">
      {
        momentos.map((m, i) => (
          <figure class={`momento momento--${i}`} data-parallax={[0.12, -0.18, 0.26, -0.08, 0.18][i]}>
            <Foto src={m.src} alt={m.alt} sizes="(max-width: 900px) 70vw, 34vw" anchos={[480, 800, 1100]} />
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ============ CLIENTES + TESTIMONIO ============ -->
  <section class="seccion seccion--arena confianza" aria-labelledby="confianza-titulo">
    <h2 id="confianza-titulo" class="sr-only">Han confiado en nosotras</h2>
    <div class="marquesina" aria-label="Clientes y entidades con las que hemos trabajado">
      <ul class="marquesina__pista">
        {[...home.clientes, ...home.clientes].map((c: string, i: number) => (
          <li aria-hidden={i >= home.clientes.length ? 'true' : undefined}>{c}<span class="marquesina__gota" aria-hidden="true"></span></li>
        ))}
      </ul>
    </div>
    <div class="contenedor opiniones" data-reveal>
      <div class="opiniones__cabeza">
        <p class="etiqueta">Lo que dicen de nosotras</p>
        <div class="opiniones__flechas">
          <button type="button" class="opiniones__flecha" data-op="-1" aria-controls="lista-opiniones"><span aria-hidden="true">←</span><span class="sr-only">Opinión anterior</span></button>
          <button type="button" class="opiniones__flecha" data-op="1" aria-controls="lista-opiniones"><span aria-hidden="true">→</span><span class="sr-only">Opinión siguiente</span></button>
        </div>
      </div>
      <ul class="opiniones__lista" id="lista-opiniones" tabindex="0" aria-label="Opiniones de clientes" data-opiniones>
        {opiniones.map((o, i) => (
          <li class="opinion">
            <figure>
              <span class="opinion__comillas" aria-hidden="true">“</span>
              <blockquote><p>{o.texto}</p></blockquote>
              <figcaption>
                <span class="opinion__inicial" aria-hidden="true">{o.autor?.charAt(0)}</span>
                <span>{o.autor}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PRÓXIMOS EVENTOS ============ -->
  {
    eventos.length > 0 && (
      <section class="seccion proximos" aria-labelledby="proximos-titulo">
        <div class="contenedor">
          <div class="proyectos__cabeza">
            <div>
              <p class="etiqueta" data-reveal>Agenda</p>
              <h2 id="proximos-titulo" class="titulo-2" data-split>Próximos <em>eventos</em></h2>
            </div>
            <a class="enlace-flecha" href="/eventos/" data-reveal>Ver la agenda completa →</a>
          </div>
          <ul class="proximos__lista">
            {eventos.map((e, i) => (
              <li class="proximo" data-reveal style={`--d:${i * 100}`}>
                <a href={e.data.enlace ?? '/eventos/'} {...(e.data.enlace?.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                  <time class="proximo__fecha" datetime={e.data.fecha.toISOString().slice(0, 10)}>
                    <strong>{fecha(e.data.fecha, { day: 'numeric' })}</strong>
                    <span>{fecha(e.data.fecha, { month: 'short' })}</span>
                  </time>
                  <span class="proximo__info">
                    <span class="titulo-3">{e.data.titulo}</span>
                    <span class="proximo__lugar">{e.data.lugar}</span>
                  </span>
                  <span class="proximo__estado">{e.data.estado === 'agotado' ? 'Agotado' : 'Más información'} <span aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<script>
  import '../scripts/inicio';
</script>

<style>
  /* ---------- HERO ---------- */
  .hero { --fondo: var(--hueso); position: relative; height: 100svh; min-height: 640px; overflow: hidden; background: var(--fondo); color: var(--tinta); }
  .hero__brillo {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(42% 46% at 50% 42%, rgba(255, 138, 102, 0.26), transparent 70%),
      radial-gradient(30% 35% at 12% 88%, rgba(234, 226, 183, 0.55), transparent 70%),
      radial-gradient(26% 30% at 90% 10%, rgba(234, 226, 183, 0.4), transparent 70%);
  }
  .hero__gota { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; opacity: 0; }
  .hero__gota-plana {
    position: absolute; left: 0; top: 0; width: 100px; aspect-ratio: 1; z-index: 0; pointer-events: none; display: none;
    background: var(--degradado); -webkit-mask: var(--gota) center / contain no-repeat; mask: var(--gota) center / contain no-repeat;
    transform-origin: 0 0; will-change: transform;
  }
  .hero__centro { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding-top: 70px; }
  .hero__logo { width: min(80vw, 980px, 118vh); color: var(--tinta); }
  .hero__logo :global(.logo) { width: 100%; height: auto; overflow: visible; }
  .hero__logo :global(.logo__letra) { transform-box: fill-box; transform-origin: 50% 100%; will-change: transform, opacity, filter; }
  .hero__etiqueta { margin: clamp(26px, 4vh, 44px) 0 14px; }
  .hero__claim { font-family: var(--ff-display); font-size: clamp(1.45rem, 2.7vw, 2.5rem); line-height: 1.2; letter-spacing: -0.02em; max-width: 24ch; }
  .hero__claim :global(em) { font-style: italic; color: var(--naranja-texto); }
  .hero__acciones { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px 30px; margin-top: clamp(24px, 4vh, 40px); }
  .hero__bajar {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0; z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gris);
  }
  .hero__bajar span { width: 1.5px; height: 42px; background: linear-gradient(var(--naranja), transparent); animation: bajar 2.2s var(--ease) infinite; transform-origin: top; }
  @keyframes bajar { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  /* Entrada al cargar: las letras suben con giro 3D y la gota aparece */
  :global(.movimiento) .hero__logo :global(.logo__letra) { animation: letra-entra 1.3s var(--ease-out) both; animation-delay: calc(0.25s + var(--k) * 0.08s); }
  :global(.movimiento) .hero__logo :global(.logo__gota) { transform-box: fill-box; transform-origin: 50% 50%; animation: gota-entra 1.4s var(--ease-out) both; }
  :global(.movimiento) .hero__logo { perspective: 900px; }
  @keyframes letra-entra { from { opacity: 0; transform: translateY(60%) rotateX(-80deg); } }
  @keyframes gota-entra { from { opacity: 0; transform: scale(0.4) rotate(-40deg); } }
  :global(.movimiento) [data-hero-fade]:not([data-hero-fade='sin-entrada']) { animation: aparece 1s var(--ease-out) both; animation-delay: 0.7s; }
  :global(.movimiento) .hero__acciones { animation-delay: 1.15s; }
  @keyframes aparece { from { opacity: 0; transform: translateY(20px); } }
  :global(.gota-3d) .hero__logo :global(.logo__gota) { opacity: 0 !important; animation: none; }
  .hero:global(.usa-plana) .hero__logo :global(.logo__gota) { opacity: 0 !important; animation: none; }

  /* Portal: sin animación es un bloque normal con la foto final */
  .hero__portal { position: relative; }
  .hero__portal-foto { position: relative; overflow: hidden; }
  .hero__portal-foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  :global(html:not(.portal-animado)) .hero { height: auto; min-height: 0; }
  :global(html:not(.portal-animado)) .hero__centro { min-height: 100svh; }
  :global(html:not(.portal-animado)) .hero__bajar { display: none; }
  :global(html:not(.portal-animado)) .hero__portal { margin: 0 var(--gutter) var(--gutter); border-radius: var(--radio-lg); overflow: hidden; height: 80vh; }
  :global(html:not(.portal-animado)) .hero__portal-foto { position: absolute; inset: 0; }
  :global(html:not(.portal-animado)) .hero__portal-foto:not(:last-of-type) { display: none; }
  :global(html:not(.portal-animado)) .hero__portal-texto { position: absolute; inset: auto 0 0 0; padding-bottom: 40px; color: #fff; z-index: 5; }
  :global(html:not(.portal-animado)) .hero__portal::after { content: ''; position: absolute; inset: 0; z-index: 4; background: linear-gradient(transparent 40%, rgba(10, 8, 6, 0.75)); }

  /* Con animación: el portal se superpone y se abre con la forma de la gota */
  :global(.portal-animado) .hero__portal {
    --m: 0px; --px: 50%; --py: 50%;
    position: absolute; inset: 0; z-index: 3; visibility: hidden; background: #0d0b09; display: none;
    -webkit-mask: var(--gota) var(--px) var(--py) / var(--m) var(--m) no-repeat; mask: var(--gota) var(--px) var(--py) / var(--m) var(--m) no-repeat;
  }
  :global(.portal-animado) .hero.portal-listo .hero__portal { display: block; }
  :global(.portal-animado) .hero__portal-foto { position: absolute; inset: 0; will-change: transform, opacity; }
  :global(.portal-animado) .hero__portal::after { content: ''; position: absolute; inset: 0; z-index: 4; background: linear-gradient(180deg, rgba(10, 8, 6, 0.1) 30%, rgba(10, 8, 6, 0.72)); pointer-events: none; }
  :global(.portal-animado) .hero__portal-texto { position: absolute; inset: auto 0 0 0; z-index: 5; padding-bottom: clamp(40px, 8vh, 90px); color: #fff; opacity: 0; }
  .hero__portal-texto .titulo-1 { margin: 0; max-width: 16ch; }

  @media (max-width: 760px) {
    .hero__logo { width: 88vw; }
    .hero__acciones .enlace-flecha { display: none; }
  }

  /* ---------- FRANJA ---------- */
  .franja { overflow: hidden; padding-block: clamp(56px, 7vw, 100px) 0; }
  .franja__fila { display: flex; width: max-content; margin: 0; white-space: nowrap; font-family: var(--ff-display); font-size: clamp(2.6rem, 7vw, 6.6rem); line-height: 1.1; letter-spacing: -0.03em; will-change: transform; }
  .franja__fila span { display: inline-flex; align-items: center; gap: 0.4em; padding-right: 0.4em; }
  .franja__fila--b { font-style: italic; color: transparent; -webkit-text-stroke: 1.2px var(--naranja-texto); transform: translateX(-25%); }
  .franja__gota { display: inline-block; width: 0.42em; height: 0.42em; background: var(--degradado); -webkit-mask: var(--gota) center / contain no-repeat; mask: var(--gota) center / contain no-repeat; }
  .franja__fila--b .franja__gota { opacity: 0.6; }

  /* ---------- INTRO ---------- */
  .intro__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 110px); align-items: end; }
  .intro__grid .entradilla { margin-bottom: 28px; max-width: 44ch; }
