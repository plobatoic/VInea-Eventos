---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import BandaCTA from '../components/BandaCTA.astro';
import { getEntry, render } from 'astro:content';

const pagina = await getEntry('paginas', 'accesibilidad-inclusion');
if (!pagina) throw new Error('Falta paginas/accesibilidad-inclusion.md');
const d = pagina.data;
const { Content } = await render(pagina);
const titular = (d.titular ?? 'Eventos para <em>todas las personas</em>').replace(/\*([^*]+)\*/g, '<em>$1</em>');
---

<Base titulo={d.seo?.title ?? 'Accesibilidad e inclusión'} descripcion={d.seo?.description ?? d.resumen} imagen={d.imagen}>
  <CabeceraPagina
    etiqueta={d.etiqueta ?? 'Accesibilidad e inclusión'}
    titulo={titular}
    entradilla={d.resumen}
    imagen={d.imagen}
    imagenAlt={d.imagenAlt}
    migas={[{ texto: 'Accesibilidad e inclusión' }]}
  />

  <section class="seccion seccion--papel">
    <div class="contenedor--estrecho prosa acc" data-reveal><Content /></div>
  </section>

  {
    d.iniciativas.length > 0 && (
      <section class="seccion seccion--oscura iniciativas" aria-labelledby="ini-t">
        <div class="contenedor">
          <p class="etiqueta" data-reveal>Lo que ya hacemos</p>
          <h2 id="ini-t" class="titulo-1" data-split>Iniciativas <em>que suman</em></h2>
          <ul class="iniciativas__grid">
            {d.iniciativas.map((x, i) => (
              <li class="iniciativa" data-reveal data-tilt style={`--d:${(i % 3) * 110}`}>
                <span class="iniciativa__gota" aria-hidden="true" />
                <h3 class="titulo-3">{x.titulo}</h3>
                <p>{x.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="seccion compromiso" aria-labelledby="comp-t">
    <div class="contenedor compromiso__grid">
      <h2 id="comp-t" class="titulo-2" data-split>Cómo lo aplicamos <em>en tu evento</em></h2>
      <ul class="compromiso__lista">
        <li data-reveal>Analizamos la accesibilidad física del espacio: accesos, recorridos, aseos y zonas de descanso.</li>
        <li data-reveal style="--d:80">Proponemos intérprete de lengua de signos, subtitulado y bucle magnético cuando el evento lo necesita.</li>
        <li data-reveal style="--d:160">Diseñamos la comunicación del evento en lectura fácil y con contraste suficiente.</li>
        <li data-reveal style="--d:240">Trabajamos con entidades especializadas para que nadie se quede fuera.</li>
      </ul>
    </div>
  </section>

  <BandaCTA titulo="¿Quieres que tu evento sea accesible?" texto="Te ayudamos a pensarlo desde el principio, sin que se note el esfuerzo." />
</Base>

<style>
  .acc :global(p:first-child) { font-family: var(--ff-display); font-size: clamp(1.5rem, 2.6vw, 2.2rem); line-height: 1.3; color: var(--tinta); }
  .iniciativas__grid { list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .iniciativa { --rx: 0deg; --ry: 0deg; padding: 34px 30px; border-radius: var(--radio); background: var(--noche-2); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08); transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 0.6s var(--ease-out); }
  .iniciativa__gota { display: block; width: 40px; height: 40px; margin-bottom: 30px; background: var(--degradado); -webkit-mask: var(--gota) center / contain no-repeat; mask: var(--gota) center / contain no-repeat; }
  .iniciativa h3 { margin-bottom: 12px; }
  .iniciativa p { margin: 0; color: #cfc7bc; }
  .compromiso__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 100px); align-items: start; }
  .compromiso__lista { list-style: none; margin: 0; padding: 0; }
  .compromiso__lista li { position: relative; padding: 22px 0 22px 44px; border-bottom: 1px solid var(--linea); font-size: var(--t-grande); }
  .compromiso__lista li::before { content: ''; position: absolute; left: 0; top: 28px; width: 20px; height: 20px; background: var(--degradado); -webkit-mask: var(--gota) center / contain no-repeat; mask: var(--gota) center / contain no-repeat; }
  @media (max-width: 860px) { .compromiso__grid { grid-template-columns: 1fr; } }
</style>
